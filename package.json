{
  "name": "@joethefkingfrypan/bk-standard-version",
  "version": "5.3.0",
  "description": "Replacement for `npm version` with automatic CHANGELOG generation",
  "bin": "bin/cli.js",
  "scripts": {
    "coverage": "nyc report --reporter=text-lcov | coveralls",
    "test": "nyc mocha --timeout=40000 test.js",
    "test-only": "NODE_ENV=test nyc mocha --timeout=40000 test.js",
    "release": "bin/cli.js"
  },
  "nyc": {
    "exclude": [
      "tmp/**"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheOptimisticFactory/bk-standard-version.git"
  },
  "engines": {
    "node": ">=4.0"
  },
  "keywords": [
    "conventional-changelog",
    "recommended",
    "changelog",
    "automatic",
    "workflow",
    "version",
    "TheOptimisticFactory",
    "standard"
  ],
  "author": "Romain Gagnaire <romain.gagnaire.pro@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/TheOptimisticFactory/bk-standard-version/issues"
  },
  "homepage": "https://github.com/TheOptimisticFactory/bk-standard-version#readme",
  "peerDependencies": {
    "config": ">=3.X"
  },
  "dependencies": {
    "@joethefkingfrypan/bk-conventional-changelog": "3.0.0",
    "@sportheroes/bk-conventional-recommended-bump": "1.2.0",
    "chalk": ">=4.1.2 <5.X",
    "conventional-changelog": ">=5.1.0 <6.X",
    "figures": "6.1.0",
    "git-branch": "2.0.1",
    "semver": "7.7.4",
    "yargs": ">=17.2.2 <18.X"
  },
  "devDependencies": {
    "chai": ">=4.5.0 <5.X",
    "config": "4.3.0",
    "coveralls": "<4.X",
    "mocha": "11.7.5",
    "mock-git": "2.0.0",
    "mockery": "2.1.0",
    "nyc": "17.1.0",
    "shelljs": "0.10.0"
  }
}
